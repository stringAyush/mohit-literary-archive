# Copy this file to .env and replace every placeholder.
# Never commit .env — it is listed in .gitignore.

# PostgreSQL connection string (Neon, Supabase, Railway, or your own server).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Public address of the site, with no trailing slash. Used for canonical URLs,
# the sitemap and Open Graph tags. Use http://localhost:3000 in development.
SITE_URL="http://localhost:3000"

# Long random string (at least 32 characters). Used to sign contact-form
# tokens and to hash IP addresses for rate limiting. Required in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="replace-with-a-long-random-string"

# Secret that the scheduler must send to /api/cron/publish-scheduled (32+
# random characters when enabled). Leave empty to disable the endpoint.
CRON_SECRET=""

# Optional email delivery for the contact form, through Resend (https://resend.com).
# When any of these are empty, messages are still saved and shown in /admin/inquiries,
# but no email is sent.
RESEND_API_KEY=""
CONTACT_TO_EMAIL=""
CONTACT_FROM_EMAIL=""

# Development only. "true" shows works marked as demonstration content.
# Production rejects this setting when it is true.
SHOW_DEMO_CONTENT="false"

# Used once by `npm run admin:create` if you prefer not to type the values.
# Remove them from .env after creating the account.
ADMIN_EMAIL=""
ADMIN_NAME=""
ADMIN_PASSWORD=""
